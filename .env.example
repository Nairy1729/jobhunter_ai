# ==============================================================================
# JobHunter AI — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your secrets before starting the application.

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobhunter_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ------------------------------------------------------------------------------
# 2. Server & Security Configuration
# ------------------------------------------------------------------------------
PORT=8085
APP_JWT_SECRET=jobhunter_production_secure_jwt_secret_key_minimum_256_bits_length_here_change_in_prod
APP_JWT_EXPIRATION_MS=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://jobhunter.ai

# ------------------------------------------------------------------------------
# 3. Gemini AI Configuration (Private ATS Matching & OfferPilot LaTeX Tailoring)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
AI_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FLASH=gemini-flash-latest
GEMINI_MODEL_PRO=gemini-flash-latest
GEMINI_MODEL_EMBEDDING=gemini-embedding-001

# ------------------------------------------------------------------------------
# 4. Firecrawl Web Discovery API (Optional for crawling deep recruitment notices)
# ------------------------------------------------------------------------------
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8085
