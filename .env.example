# ==============================================================================
# JobHunter AI — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set these environment variables in your hosting provider
# (e.g. Render / Railway / Fly.io for Backend, Vercel / Netlify for Frontend, Supabase / Neon for Postgres).

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Supabase / Neon)
# ------------------------------------------------------------------------------
# In production on free-tier providers like Supabase, Neon, or Tembo, append ?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobhunter_db?stringtype=unspecified
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ------------------------------------------------------------------------------
# 2. Server & Security Configuration
# ------------------------------------------------------------------------------
# Host-assigned port (e.g., Render, Railway, Cloud Run automatically inject $PORT)
PORT=8085

# Minimum 256-bit (32+ characters) cryptographic signing secret.
# In production, generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_random_secure_256_bit_string_at_least_32_chars
APP_JWT_SECRET=replace_with_a_random_secure_256_bit_string_at_least_32_chars
APP_JWT_EXPIRATION_MS=900000

# Comma-separated list of allowed frontend origins for CORS.
# Set this to your deployed frontend domain (e.g. https://jobhunter.vercel.app)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://jobhunter.vercel.app

# ------------------------------------------------------------------------------
# 3. Government Jobs Background Scheduler
# ------------------------------------------------------------------------------
# Set to 'false' (default) on zero-cost free-tier hosting to prevent unnecessary CPU/RAM
# consumption and out-of-quota crawler execution while sleeping. Set to 'true' only if scheduled
# hourly crawling is explicitly desired on a dedicated server.
GOVERNMENT_SCHEDULER_ENABLED=false

# ------------------------------------------------------------------------------
# 4. Gemini AI Configuration (Private ATS Matching & OfferPilot LaTeX Tailoring)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
AI_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FLASH=gemini-flash-latest
GEMINI_MODEL_PRO=gemini-flash-latest
GEMINI_MODEL_EMBEDDING=gemini-embedding-001

# ------------------------------------------------------------------------------
# 5. Firecrawl Web Discovery API (Optional for crawling deep recruitment notices)
# ------------------------------------------------------------------------------
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ------------------------------------------------------------------------------
# 6. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Deployed backend API base URL (must NOT contain a trailing slash).
# Example: https://jobhunter-api.onrender.com
VITE_API_URL=http://localhost:8085
