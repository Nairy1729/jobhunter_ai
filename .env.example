# JobHunter AI Environment Variables
# Copy this file to .env and provide your API keys

# Gemini AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
AI_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FLASH=gemini-flash-latest
GEMINI_MODEL_PRO=gemini-flash-latest
GEMINI_MODEL_EMBEDDING=gemini-embedding-001

# Firecrawl Web Scraping & Discovery API Key
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
